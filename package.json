  "engines": {
    "node": ">=12.20 <13"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "bash tools/typescript/run_tsc.sh",
    "bundle": "bash tools/esbuild/run_esbuild.sh",
    "test": "bash tools/mocha/run_mocha.sh",
    "coverage": "bash tools/c8/run_c8.sh",
    "coverage:nyc": "bash tools/nyc/run_nyc.sh",
    "lint": "bash tools/eslint/run_eslint.sh",
    "tools:verify": "ts-node tools/tool_integration.ts --verify",
    "tools:list": "ts-node tools/tool_integration.ts --list",
    "tools:all": "ts-node tools/tool_integration.ts --run-all",
    "check": "ts-node tools/full_check.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.1.0",
    "@opentelemetry/sdk-node": "0.29.2",
    "@opentelemetry/sdk-trace-base": "1.3.1",
    "axios": "0.21.0",
    "lodash": "4.17.15",
    "minimist": "1.2.5",
    "node-fetch": "2.6.0",
    "tar": "6.1.0"
  },
  "devDependencies": {
    "@cyclonedx/cdxgen": "8.6.3",
    "@stryker-mutator/core": "5.6.1",
    "@stryker-mutator/mocha-runner": "5.6.1",
    "@types/chai": "4.3.5",
    "@types/lodash": "4.14.202",
    "@types/minimist": "1.2.5",
    "@types/mocha": "9.1.1",
    "@types/node": "18.19.50",
    "@types/node-fetch": "2.6.11",
    "@types/tar": "6.1.11",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "c8": "8.0.1",
    "chai": "4.3.10",
    "dependency-cruiser": "11.18.0",
    "esbuild": "0.21.5",
    "eslint": "8.57.1",
    "eslint-plugin-security": "2.1.1",
    "eslint-plugin-sonarjs": "0.15.0",
    "eslint-scope": "7.2.2",
    "espree": "9.6.1",
